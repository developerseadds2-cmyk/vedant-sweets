<header
  class="vs-header-root full-width"
  data-sticky="{{ section.settings.enable_sticky }}"
  style="--vs-header-padding-y: {{ section.settings.padding_y }}px"
>
  {% if section.settings.show_announcement %}
    <div class="vs-announcement" aria-label="Announcements">
      <div class="vs-announcement__marquee-wrapper">
        <div class="vs-announcement__marquee" aria-hidden="false">
          {% assign items_1 = "Free Delivery on orders above ₹999,Handcrafted with Love,Festive Specials – Shop Now,100% Pure Cow Ghee,Traditional Recipes" | split: "," %}
          {% for item in items_1 %}
            <div class="vs-announcement__item">
              {% case forloop.index %}
                {% when 1 %}
                  <svg class="vs-announcement__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                  </svg>
                {% when 2 %}
                  <svg class="vs-announcement__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
                    <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
                  </svg>
                {% when 3 %}
                  <svg class="vs-announcement__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 12 20 22 4 22 4 12"></polyline>
                    <rect x="2" y="7" width="20" height="5"></rect>
                    <line x1="12" y1="22" x2="12" y2="7"></line>
                    <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                    <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
                  </svg>
                {% else %}
                  <svg class="vs-announcement__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                  </svg>
              {% endcase %}
              <span class="vs-announcement__text">{{ item }}</span>
            </div>
          {% endfor %}
        </div>
        {% # Duplicate track for infinite seamless loop %}
        <div class="vs-announcement__marquee" aria-hidden="true">
          {% for item in items_1 %}
            <div class="vs-announcement__item">
              {% case forloop.index %}
                {% when 1 %}
                  <svg class="vs-announcement__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                  </svg>
                {% when 2 %}
                  <svg class="vs-announcement__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
                    <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
                  </svg>
                {% when 3 %}
                  <svg class="vs-announcement__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 12 20 22 4 22 4 12"></polyline>
                    <rect x="2" y="7" width="20" height="5"></rect>
                    <line x1="12" y1="22" x2="12" y2="7"></line>
                    <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                    <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
                  </svg>
                {% else %}
                  <svg class="vs-announcement__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                  </svg>
              {% endcase %}
              <span class="vs-announcement__text">{{ item }}</span>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  <div class="vs-header-main">
    <div class="vs-header-inner">
      <a class="vs-brand-link" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        <img
          class="vs-logo-img"
          src="{{ 'logo.png' | asset_url }}"
          alt="{{ shop.name | escape }}"
          width="554"
          height="450"
          loading="eager"
        >
      </a>

      {% # Center Search Bar %}
      <div class="vs-header-search" data-predictive-search-root>
        <form action="{{ routes.search_url }}" method="get" role="search" class="vs-search-bar" data-search-form>
          <svg class="vs-search-bar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="Search for kaju katli, laddoo, gift boxes..."
            class="vs-search-bar__input"
            aria-label="Search sweets"
            autocomplete="off"
            data-search-input
          >
          <button type="button" class="vs-search-bar__voice-btn" data-voice-search aria-label="Voice Search" title="Search by Voice">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
              <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
              <line x1="12" y1="19" x2="12" y2="22"></line>
            </svg>
          </button>
          <button type="submit" class="vs-search-bar__submit-btn" aria-label="Submit search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="7"></circle>
              <line x1="21" y1="21" x2="16" y2="16"></line>
            </svg>
          </button>
        </form>

        {% # Predictive / Popular Search Dropdown Panel %}
        <div class="vs-search-dropdown" data-search-dropdown aria-hidden="true">
          {% # State A: Popular Searches & Categories (shown on focus when query is empty) %}
          <div class="vs-search-popular" data-search-popular>
            <div class="vs-search-dropdown__section">
              <div class="vs-search-dropdown__header">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>
                </svg>
                <span>Popular Searches</span>
              </div>
              <div class="vs-popular-tags">
                <button type="button" class="vs-popular-tag" data-search-keyword="Kaju Katli">Kaju Katli</button>
                <button type="button" class="vs-popular-tag" data-search-keyword="Khoya Peda">Khoya Peda</button>
                <button type="button" class="vs-popular-tag" data-search-keyword="Motichoor Laddoo">Motichoor Laddoo</button>
                <button type="button" class="vs-popular-tag" data-search-keyword="Pure Desi Ghee">Pure Desi Ghee</button>
                <button type="button" class="vs-popular-tag" data-search-keyword="Assorted Mithai Box">Assorted Mithai Box</button>
                <button type="button" class="vs-popular-tag" data-search-keyword="Gulab Jamun">Gulab Jamun</button>
                <button type="button" class="vs-popular-tag" data-search-keyword="Dry Fruits">Dry Fruits</button>
              </div>
            </div>

            <div class="vs-search-dropdown__section">
              <div class="vs-search-dropdown__header">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="7" height="7" x="3" y="3" rx="1"/>
                  <rect width="7" height="7" x="14" y="3" rx="1"/>
                  <rect width="7" height="7" x="14" y="14" rx="1"/>
                  <rect width="7" height="7" x="3" y="14" rx="1"/>
                </svg>
                <span>Browse Categories</span>
              </div>
              <div class="vs-search-quick-links">
                {% assign search_dropdown_colls = collections | where: 'image' %}
                {% if search_dropdown_colls.size == 0 %}
                  {% assign search_dropdown_colls = collections %}
                {% endif %}

                {% assign rendered_search_colls = 0 %}
                {% for coll in search_dropdown_colls %}
                  {% if coll.handle == 'frontpage' %}
                    {% continue %}
                  {% endif %}
                  {% assign rendered_search_colls = rendered_search_colls | plus: 1 %}
                  {% assign coll_img = coll.featured_image | default: coll.image %}
                  <a href="{{ coll.url }}" class="vs-search-quick-link">
                    {% if coll_img != blank %}
                      <img src="{{ coll_img | image_url: width: 80, height: 80, crop: 'center' }}" alt="{{ coll.title | escape }}" class="vs-search-quick-link__img" width="36" height="36" loading="lazy">
                    {% else %}
                      <span class="vs-search-quick-link__placeholder">🍬</span>
                    {% endif %}
                    <span class="vs-search-quick-link__title">{{ coll.title | escape }}</span>
                  </a>
                  {% if rendered_search_colls >= 4 %}
                    {% break %}
                  {% endif %}
                {% endfor %}

                {% # Fallback if store has fewer than 4 custom collections %}
                {% if rendered_search_colls < 4 %}
                  {% assign fallback_titles = "Sweets & Mithai,Namkeen & Bhujia,Dry Fruits & Nuts,Gift Boxes" | split: "," %}
                  {% assign fallback_imgs = "collection-mithai.jpg,collection-kaju.jpg,collection-dry-fruits.jpg,collection-gift-packs.jpg" | split: "," %}
                  {% assign fallback_urls = "/collections/all,/collections/all,/collections/all,/collections/all" | split: "," %}
                  {% for f_title in fallback_titles %}
                    {% if forloop.index > rendered_search_colls and rendered_search_colls < 4 %}
                      {% assign idx = forloop.index0 %}
                      <a href="{{ fallback_urls[idx] }}" class="vs-search-quick-link">
                        <img src="{{ fallback_imgs[idx] | asset_url }}" alt="{{ f_title }}" class="vs-search-quick-link__img" width="36" height="36" loading="lazy">
                        <span class="vs-search-quick-link__title">{{ f_title }}</span>
                      </a>
                    {% endif %}
                  {% endfor %}
                {% endif %}
              </div>
            </div>
          </div>

          {% # State B: Live Ajax Search Results (shown on typing) %}
          <div class="vs-search-results" data-search-results style="display: none;">
            <div class="vs-search-results__loading" data-search-loading>
              <div class="vs-search-spinner"></div>
              <span>Searching delicious sweets...</span>
            </div>
            <div class="vs-search-results__list" data-search-list></div>
            <div class="vs-search-results__empty" data-search-empty style="display: none;">
              <p>No products found matching "<strong data-search-query-text></strong>"</p>
            </div>
            <div class="vs-search-dropdown__footer" data-search-footer style="display: none;">
              <a href="#" class="vs-search-view-all" data-search-view-all-link>
                <span>View all results for "<span data-search-query-text-footer></span>"</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      {% # Right Actions: Delivery Location, Account, Wishlist, Cart %}
      <div class="vs-actions vs-actions--rich">
        {% # Deliver To Location Selector %}
        <button
          type="button"
          class="vs-action-item vs-action-item--location"
          data-open-location-modal
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-label="Select delivery location"
        >
          <div class="vs-action-item__icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <span class="vs-action-item__label vs-location-label-stack">
            <span class="vs-location-value" data-current-delivery-address>Select Location</span>
          </span>
          <svg class="vs-action-item__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>

        <a class="vs-action-item vs-action-item--wishlist" href="/pages/wishlist" aria-label="Wishlist">
          <div class="vs-action-item__icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
            </svg>
            <span class="vs-badge-count" data-wishlist-count>0</span>
          </div>
        </a>

        <a class="vs-action-item vs-action-item--cart" href="{{ routes.cart_url }}" aria-label="{{ 'sections.header.cart' | t: count: cart.item_count }}">
          <div class="vs-action-item__icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 8h16l-1.2 12H5.2L4 8Z"></path>
              <path d="M8 9V6a4 4 0 0 1 8 0v3"></path>
            </svg>
            <span class="vs-badge-count">{{ cart.item_count | default: 0 }}</span>
          </div>
        </a>

        {% # User Account / Sign In Trigger %}
        <button
          type="button"
          class="vs-action-item vs-action-item--account"
          data-open-login-drawer
          aria-label="{% if customer %}Account{% else %}Sign In{% endif %}"
          aria-haspopup="dialog"
        >
          <div class="vs-action-item__icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
        </button>

        {% # Mobile Menu Hamburger button %}
        <button
          class="vs-menu-toggle"
          type="button"
          data-mobile-menu-toggle
          aria-controls="vs-navigation-{{ section.id }}"
          aria-expanded="false"
          aria-label="{{ 'sections.header.menu_open' | t }}"
          data-open-label="{{ 'sections.header.menu_open' | t | escape }}"
          data-close-label="{{ 'sections.header.menu_close' | t | escape }}"
        >
          <span class="vs-menu-toggle__bars vs-menu-toggle__open-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <svg class="vs-menu-toggle__close-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
            <path d="m6 6 12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  {% # Secondary Nav Row with Category Links & Separators %}
  <div class="vs-header-categories-bar">
    <div class="vs-header-categories-inner">
      <nav class="vs-navigation" id="vs-navigation-{{ section.id }}" aria-label="{{ 'sections.header.navigation' | t }}">
        <div class="vs-navigation__header">
          <a class="vs-navigation__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
            <img
              class="vs-navigation__logo"
              src="{{ 'logo.png' | asset_url }}"
              alt="{{ shop.name | escape }}"
              width="554"
              height="450"
              loading="lazy"
            >
          </a>
          <button
            class="vs-navigation__close"
            type="button"
            data-mobile-menu-close
            aria-label="{{ 'sections.header.menu_close' | t }}"
          >
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
              <path d="m6 6 12 12M18 6 6 18"></path>
            </svg>
          </button>
        </div>

        <ul class="vs-nav-menu vs-nav-menu--categories">
          {% # 1. Home %}
          <li class="vs-nav-item">
            <a class="vs-nav-anchor{% if request.path == routes.root_url %} is-current{% endif %}" href="{{ routes.root_url }}">
              Home
            </a>
          </li>

          {% # 2. All Categories / Shop All (Mega Menu) %}
          <li class="vs-nav-item vs-nav-item--has-megamenu">
            <a class="vs-nav-anchor" href="{{ routes.all_products_collection_url }}" data-mobile-mega-toggle>
              All Categories
              <svg class="vs-nav-chevron-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </a>
                        <!-- Native Mobile Accordion for All Categories -->
            <ul class="vs-mobile-megamenu-accordion">
              {% if valid_colls_count > 0 %}
                {% for coll in collections %}
                  {% if coll.handle == "all" or coll.handle == "frontpage" %}{% continue %}{% endif %}
                  <li><a class="vs-sublink" href="{{ coll.url }}">{{ coll.title | escape }}</a></li>
                {% endfor %}
              {% else %}
                <li><a class="vs-sublink" href="/collections/all">Traditional Desi Ghee Pinni & Sweets</a></li>
                <li><a class="vs-sublink" href="/collections/all">Fresh Artisanal Mithai</a></li>
                <li><a class="vs-sublink" href="/collections/all">Crispy Namkeen & Savouries</a></li>
                <li><a class="vs-sublink" href="/collections/dry-fruits">Handpicked Dry Fruits & Nuts</a></li>
                <li><a class="vs-sublink" href="/collections/gift-packs">Festive & Celebration Hampers</a></li>
              {% endif %}
            </ul>
            {% render 'mega-menu' %}
          </li>

          {% # 3. Sweets & Mithai %}
          <li class="vs-nav-item vs-nav-item--has-submenu">
            <a class="vs-nav-anchor" href="/collections/all" data-mobile-submenu-toggle>
              Sweets & Mithai
              <svg class="vs-nav-chevron-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </a>
            <ul class="vs-submenu">
              <li><a class="vs-sublink" href="/collections/all">Kaju Katli & Kaju Sweets</a></li>
              <li><a class="vs-sublink" href="/collections/all">Barfi & Peda</a></li>
              <li><a class="vs-sublink" href="/collections/all">Ladoo Collection</a></li>
              <li><a class="vs-sublink" href="/collections/all">Gulab Jamun & Rasgulla</a></li>
              <li><a class="vs-sublink" href="/collections/all">Milk Cake & Kalakand</a></li>
              <li><a class="vs-sublink" href="/collections/all">Bengali & Malai Sweets</a></li>
              <li><a class="vs-sublink" href="/collections/all">Traditional Punjabi Sweets</a></li>
              <li><a class="vs-sublink" href="/collections/all">Sugar-Free Sweets</a></li>
            </ul>
          </li>

          {% # 4. Namkeen & Bhujia %}
          <li class="vs-nav-item vs-nav-item--has-submenu">
            <a class="vs-nav-anchor" href="/collections/all" data-mobile-submenu-toggle>
              Namkeen & Bhujia
              <svg class="vs-nav-chevron-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </a>
            <ul class="vs-submenu">
              <li><a class="vs-sublink" href="/collections/all">Aloo & Bikaneri Bhujia</a></li>
              <li><a class="vs-sublink" href="/collections/all">Plain & Masala Bhujia</a></li>
              <li><a class="vs-sublink" href="/collections/all">Ratlami & Nylon Sev</a></li>
              <li><a class="vs-sublink" href="/collections/all">Khatta Meetha Mixture</a></li>
              <li><a class="vs-sublink" href="/collections/all">Navratan & Punjabi Mixture</a></li>
              <li><a class="vs-sublink" href="/collections/all">Chana Dal & Moong Dal</a></li>
              <li><a class="vs-sublink" href="/collections/all">Roasted & Masala Chana</a></li>
            </ul>
          </li>

          {% # 5. Snacks & Savouries %}
          <li class="vs-nav-item vs-nav-item--has-submenu">
            <a class="vs-nav-anchor" href="/collections/all" data-mobile-submenu-toggle>
              Snacks & Savouries
              <svg class="vs-nav-chevron-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </a>
            <ul class="vs-submenu">
              <li><a class="vs-sublink" href="/collections/all">Samosa & Kachori</a></li>
              <li><a class="vs-sublink" href="/collections/all">Mathri & Namak Para</a></li>
              <li><a class="vs-sublink" href="/collections/all">Shakkar Para & Papdi</a></li>
              <li><a class="vs-sublink" href="/collections/all">Fafda & Gathiya</a></li>
              <li><a class="vs-sublink" href="/collections/all">Chakli & Murukku</a></li>
              <li><a class="vs-sublink" href="/collections/all">Khakhra & Farsan</a></li>
              <li><a class="vs-sublink" href="/collections/all">Tea-Time Snacks</a></li>
            </ul>
          </li>

          {% # 6. Dry Fruits & Nuts %}
          <li class="vs-nav-item vs-nav-item--has-submenu">
            <a class="vs-nav-anchor" href="/collections/dry-fruits" data-mobile-submenu-toggle>
              Dry Fruits & Nuts
              <svg class="vs-nav-chevron-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </a>
            <ul class="vs-submenu">
              <li><a class="vs-sublink" href="/collections/dry-fruits">Almonds & Cashews</a></li>
              <li><a class="vs-sublink" href="/collections/dry-fruits">Pistachios & Walnuts</a></li>
