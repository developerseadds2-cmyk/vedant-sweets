  {% # Delivery Location Modal Popup %}
  <div class="vs-modal vs-location-modal" id="vs-location-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="vs-loc-title">
    <div class="vs-modal__backdrop" data-close-location-modal></div>
    <div class="vs-modal__card">
      <div class="vs-modal__header">
        <div class="vs-modal__title-group">
          <svg class="vs-modal__pin-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8Z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <div>
            <h3 class="vs-modal__title" id="vs-loc-title">Choose Delivery Location</h3>
            <p class="vs-modal__subtitle">Select your address to check delivery availability & fees</p>
          </div>
        </div>
        <button type="button" class="vs-modal__close-btn" data-close-location-modal aria-label="Close dialog">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="vs-modal__body">
        {% # Quick Use Current Location Button %}
        <button type="button" class="vs-location-gps-btn" data-detect-location>
          <div class="vs-location-gps-btn__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <circle cx="12" cy="12" r="3"></circle>
              <line x1="12" y1="2" x2="12" y2="5"></line>
              <line x1="12" y1="19" x2="12" y2="22"></line>
              <line x1="2" y1="12" x2="5" y2="12"></line>
              <line x1="19" y1="12" x2="22" y2="12"></line>
            </svg>
          </div>
          <div class="vs-location-gps-btn__text">
            <strong>Use my current location</strong>
            <span>Detect via GPS automatically</span>
          </div>
          <svg class="vs-location-gps-btn__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>

        <div class="vs-modal-divider">
          <span>OR ENTER ADDRESS MANUALLY</span>
        </div>

        {% # Manual Address Entry Form %}
        <form class="vs-location-form" data-location-form onsubmit="return false;">
          <div class="vs-form-field">
            <label for="vs-delivery-pincode">Pincode / Postal Code <span class="vs-required">*</span></label>
            <div class="vs-input-wrapper">
              <input
                type="text"
                id="vs-delivery-pincode"
                name="pincode"
                placeholder="e.g. 110001, 400001"
                maxlength="10"
                class="vs-form-input"
                required
              >
            </div>
          </div>

          <div class="vs-form-field">
            <label for="vs-delivery-address">Flat, House no., Area, Street <span class="vs-required">*</span></label>
            <textarea
              id="vs-delivery-address"
              name="address"
              rows="2"
              placeholder="Enter your street or apartment address..."
              class="vs-form-input vs-form-textarea"
              required
            ></textarea>
          </div>

          <div class="vs-form-row">
            <div class="vs-form-field">
              <label for="vs-delivery-city">City <span class="vs-required">*</span></label>
              <input
                type="text"
                id="vs-delivery-city"
                name="city"
                placeholder="e.g. Mumbai, Delhi"
                class="vs-form-input"
                required
              >
            </div>
            <div class="vs-form-field">
              <label for="vs-delivery-state">State / Province</label>
              <input
                type="text"
                id="vs-delivery-state"
                name="state"
                placeholder="e.g. Maharashtra"
                class="vs-form-input"
              >
            </div>
          </div>

          <div class="vs-location-feedback" data-location-feedback style="display: none;"></div>

          <button type="submit" class="vs-location-submit-btn" data-save-location>
            Save Delivery Address
          </button>
        </form>
      </div>
    </div>
  </div>
  {% # Login Slide-in Side Drawer %}
  <div class="vs-drawer vs-login-drawer" id="vs-login-drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="vs-login-drawer-title">
    <div class="vs-drawer__backdrop" data-close-login-drawer></div>
    <div class="vs-drawer__panel">
      <div class="vs-drawer__header">
        <h2 class="vs-drawer__title" id="vs-login-drawer-title">Login</h2>
        <button type="button" class="vs-drawer__close-btn" data-close-login-drawer aria-label="Close login drawer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="vs-drawer__body">
        <div id="vs-login-view" class="vs-drawer-auth-view is-active">
          {% form 'customer_login', class: 'vs-drawer-form', id: 'vs-drawer-login-form' %}
            {{ form.errors | default_errors }}

            <div class="vs-drawer-field">
              <label for="vs-drawer-email" class="vs-drawer-label">
                Email Address <span class="vs-required-star">*</span>
              </label>
              <input
                type="email"
                name="customer[email]"
                id="vs-drawer-email"
                class="vs-drawer-input"
                placeholder="Email Address"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
              >
            </div>

            <div class="vs-drawer-field">
              <label for="vs-drawer-password" class="vs-drawer-label">
                Password <span class="vs-required-star">*</span>
              </label>
              <input
                type="password"
                name="customer[password]"
                id="vs-drawer-password"
                class="vs-drawer-input"
                placeholder="Password"
                autocomplete="current-password"
                required
              >
            </div>

            <button type="submit" class="vs-drawer-submit-btn">
              Log In
            </button>

            <div class="vs-drawer-links">
              <a href="#recover" class="vs-drawer-link" data-switch-auth="recover">
                Forgot your password?
              </a>
            </div>

            <button type="button" class="vs-drawer-secondary-btn" data-switch-auth="register">
              Create Account
            </button>
          {% endform %}
        </div>

        <div id="vs-recover-view" class="vs-drawer-auth-view" style="display: none;">
          <h3 class="vs-drawer-subheading">Reset your password</h3>
          <p class="vs-drawer-info">We will send you an email to reset your password.</p>

          {% form 'recover_customer_password', class: 'vs-drawer-form' %}
            {{ form.errors | default_errors }}

            <div class="vs-drawer-field">
              <label for="vs-recover-email" class="vs-drawer-label">
                Email Address <span class="vs-required-star">*</span>
              </label>
              <input
                type="email"
                name="email"
                id="vs-recover-email"
                class="vs-drawer-input"
                placeholder="Email Address"
                autocomplete="email"
                required
              >
            </div>

            <button type="submit" class="vs-drawer-submit-btn">
              Submit
            </button>

            <button type="button" class="vs-drawer-link-btn" data-switch-auth="login">
              Cancel & Return to Login
            </button>
          {% endform %}
        </div>

        <div id="vs-register-view" class="vs-drawer-auth-view" style="display: none;">
          <h3 class="vs-drawer-subheading">Create Account</h3>
          <p class="vs-drawer-info">Join Vedant Pure for seamless orders, rewards & updates.</p>

          {% form 'create_customer', class: 'vs-drawer-form' %}
            {{ form.errors | default_errors }}

            <div class="vs-drawer-field">
              <label for="vs-reg-first-name" class="vs-drawer-label">First Name</label>
              <input
                type="text"
                name="customer[first_name]"
                id="vs-reg-first-name"
                class="vs-drawer-input"
                placeholder="First Name"
              >
            </div>

            <div class="vs-drawer-field">
              <label for="vs-reg-last-name" class="vs-drawer-label">Last Name</label>
              <input
                type="text"
                name="customer[last_name]"
                id="vs-reg-last-name"
                class="vs-drawer-input"
                placeholder="Last Name"
              >
            </div>

            <div class="vs-drawer-field">
              <label for="vs-reg-email" class="vs-drawer-label">
                Email Address <span class="vs-required-star">*</span>
              </label>
              <input
                type="email"
                name="customer[email]"
                id="vs-reg-email"
                class="vs-drawer-input"
                placeholder="Email Address"
                required
              >
            </div>

            <div class="vs-drawer-field">
              <label for="vs-reg-password" class="vs-drawer-label">
                Password <span class="vs-required-star">*</span>
              </label>
              <input
                type="password"
                name="customer[password]"
                id="vs-reg-password"
                class="vs-drawer-input"
                placeholder="Password"
                required
              >
            </div>

            <button type="submit" class="vs-drawer-submit-btn">
              Create My Account
            </button>

            <button type="button" class="vs-drawer-link-btn" data-switch-auth="login">
              Already have an account? Log In
            </button>
          {% endform %}
        </div>
      </div>
    </div>
  </div>

