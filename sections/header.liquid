      <span class="vs-bottom-bar__label vs-bottom-bar__location-label" data-current-delivery-address>Location</span>
    </button>

    <a href="/collections/all" class="vs-bottom-bar__item">
      <div class="vs-bottom-bar__icon-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
      </div>
      <span class="vs-bottom-bar__label">Shop</span>
    </a>

    <button type="button" class="vs-bottom-bar__item" data-open-mobile-search aria-label="Search">
      <div class="vs-bottom-bar__icon-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>
      <span class="vs-bottom-bar__label">Search</span>
    </button>

    <a href="{{ routes.cart_url }}" class="vs-bottom-bar__item" aria-label="Cart">
      <div class="vs-bottom-bar__icon-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 8h16l-1.2 12H5.2L4 8Z"></path>
          <path d="M8 9V6a4 4 0 0 1 8 0v3"></path>
        </svg>
        <span class="vs-badge-count">{{ cart.item_count | default: 0 }}</span>
      </div>
      <span class="vs-bottom-bar__label">Cart</span>
    </a>

    <button type="button" class="vs-bottom-bar__item" data-open-login-drawer aria-label="Sign In">
      <div class="vs-bottom-bar__icon-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="8" r="4"></circle>
          <path d="M4.5 21a7.5 7.5 0 0 1 15 0"></path>
        </svg>
      </div>
      <span class="vs-bottom-bar__label">Profile</span>
    </button>
  </nav>
</header>

{% schema %}
{
  "name": "t:sections.header.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "t:sections.header.settings.enable_sticky",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "t:sections.header.settings.vertical_padding",
      "default": 5
    },
    {
      "type": "header",
      "content": "t:sections.header.settings.announcement"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "t:sections.header.settings.show_announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "t:sections.header.settings.announcement_text",
      "default": "Handcrafted mithai, made with care. Complimentary delivery on orders over ₹999."
    },
    {
      "type": "header",
      "content": "t:sections.header.settings.header"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "t:sections.header.settings.tagline",
      "default": "Artisanal mithai & savouries"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
