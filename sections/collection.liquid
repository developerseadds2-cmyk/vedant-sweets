<section class="vs-collection-page full-width" id="vs-collection-{{ section.id }}">
  {% # Breadcrumb Banner %}
  {% assign banner_image = collection.image | default: collection.featured_image %}
  {% if banner_image == blank %}
    {% if section.settings.default_banner_image != blank %}
      {% assign banner_image = section.settings.default_banner_image %}
    {% else %}
      {% assign first_coll_with_img = collections | where: 'image' | first %}
      {% assign banner_image = first_coll_with_img.image | default: 'Festive Indian Sweets in Gold and Maroon.png' %}
    {% endif %}
  {% endif %}

  <header
    class="vs-collection-banner"
    style="
      {% if banner_image.src != blank %}
        --vs-banner-bg: url('{{ banner_image | image_url: width: 2000 }}');
      {% elsif banner_image != blank %}
        --vs-banner-bg: url('{{ banner_image | asset_url }}');
      {% else %}
        --vs-banner-bg: none;
      {% endif %}
    "
  >
    <div class="vs-collection-banner__overlay"></div>
    <div class="vs-collection-banner__inner">
      <nav class="vs-breadcrumbs" aria-label="Breadcrumb">
        <ol class="vs-breadcrumbs__list">
          <li class="vs-breadcrumbs__item">
            <a class="vs-breadcrumbs__link" href="{{ routes.root_url }}">Home</a>
          </li>
          <li class="vs-breadcrumbs__separator" aria-hidden="true">›</li>
          <li class="vs-breadcrumbs__item">
            <a class="vs-breadcrumbs__link" href="{{ routes.collections_url }}">Collections</a>
          </li>
          <li class="vs-breadcrumbs__separator" aria-hidden="true">›</li>
          <li class="vs-breadcrumbs__item vs-breadcrumbs__item--current" aria-current="page">
            <span>{{ collection.title | escape }}</span>
          </li>
        </ol>
      </nav>

      <div class="vs-collection-banner__content">
        <h1 class="vs-collection-banner__title">{{ collection.title | escape }}</h1>
        {% if collection.description != blank %}
          <div class="vs-collection-banner__description">
            <p>{{ collection.description | strip_html }}</p>
          </div>
        {% endif %}
      </div>
    </div>
  </header>

  {% # Products Catalog Area with Sidebar Filters %}
  <div class="vs-collection-container">
    {% paginate collection.products by section.settings.products_per_page %}
      <div class="vs-collection-main-layout">
        {% # Filter Sidebar %}
        <div class="vs-filter-backdrop" data-filter-backdrop></div>
        <aside class="vs-filter-sidebar" id="vs-filter-sidebar">
          <div class="vs-filter-sidebar__header">
            <h3 class="vs-filter-sidebar__title">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="vs-filter-icon">
                <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
              </svg>
              <span>Filters</span>
            </h3>
            <div class="vs-filter-header-actions">
              <a href="{{ collection.url }}" class="vs-filter-clear-all">Reset</a>
              <button type="button" class="vs-filter-close-btn" data-toggle-filters aria-label="Close filters">×</button>
            </div>
          </div>

          {% # Filter Group 1: Sweet Categories (Dynamic from store collections) %}
          <div class="vs-filter-group">
            <h4 class="vs-filter-group__title">Categories</h4>
            <ul class="vs-filter-list">
              {% # All Products / All Sweets Root Option %}
              <li class="vs-filter-item">
                <a
                  href="{{ routes.all_products_collection_url }}"
                  class="vs-filter-link{% if collection.handle == 'all' %} is-active{% endif %}"
                >
                  <span class="vs-filter-checkbox"></span>
                  <span class="vs-filter-name">All Sweets</span>
                </a>
              </li>

              {% # Dynamic Collections from Store Admin %}
              {% if collections.size > 0 %}
                {% for coll in collections %}
                  {% if coll.handle == 'frontpage' or coll.handle == 'all' %}
                    {% continue %}
                  {% endif %}
                  <li class="vs-filter-item">
                    <a
                      href="{{ coll.url }}"
                      class="vs-filter-link{% if collection.handle == coll.handle %} is-active{% endif %}"
                    >
                      <span class="vs-filter-checkbox"></span>
                      <span class="vs-filter-name">{{ coll.title | escape }}</span>
                    </a>
                  </li>
                {% endfor %}
              {% else %}
                {% # Fallback if store has no custom collections created yet %}
                {% assign fallback_cats = "Mithai,Laddoo,Peda,Kaju Sweets,Dry Fruits,Gift Packs" | split: "," %}
                {% assign fallback_slugs = "/collections/mithai,/collections/laddoo,/collections/peda,/collections/kaju,/collections/dry-fruits,/collections/gift-packs" | split: "," %}
                {% for cat in fallback_cats %}
                  {% assign idx = forloop.index0 %}
                  <li class="vs-filter-item">
                    <a
                      href="{{ fallback_slugs[idx] }}"
                      class="vs-filter-link{% if collection.title == cat %} is-active{% endif %}"
                    >
                      <span class="vs-filter-checkbox"></span>
                      <span class="vs-filter-name">{{ cat }}</span>
                    </a>
                  </li>
                {% endfor %}
              {% endif %}
            </ul>
          </div>

          {% # Dynamic Shopify Product Filters (Search & Discovery) %}
          {% if collection.filters.size > 0 %}
            {% for filter in collection.filters %}
              {% case filter.type %}
                {% when 'boolean', 'list' %}
                  {% if filter.values.size > 0 %}
                    <div class="vs-filter-group">
                      <h4 class="vs-filter-group__title">{{ filter.label | escape }}</h4>
                      <ul class="vs-filter-list">
                        {% for value in filter.values %}
                          <li class="vs-filter-item">
                            <a
                              href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}"
                              class="vs-filter-link{% if value.active %} is-active{% endif %}"
                            >
                              <span class="vs-filter-checkbox"></span>
                              <span class="vs-filter-name">{{ value.label | escape }} ({{ value.count }})</span>
                            </a>
                          </li>
                        {% endfor %}
                      </ul>
                    </div>
                  {% endif %}
                {% when 'price_range' %}
                  <div class="vs-filter-group">
                    <h4 class="vs-filter-group__title">{{ filter.label | escape }}</h4>
                    <form class="vs-filter-price-form" method="get" action="{{ collection.url }}">
                      <div class="vs-filter-price-range">
                        <div class="vs-filter-price-input-wrap">
                          <span class="vs-filter-currency">{{ cart.currency.symbol }}</span>
                          <input
                            type="number"
                            name="{{ filter.min_value.param_name }}"
                            class="vs-filter-price-field"
                            placeholder="0"
                            min="0"
                            max="{{ filter.range_max | divided_by: 100.0 | ceil }}"
                            {% if filter.min_value.value %}value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %}
                            aria-label="Minimum price"
                          >
                        </div>
                        <span class="vs-filter-price-sep">–</span>
                        <div class="vs-filter-price-input-wrap">
                          <span class="vs-filter-currency">{{ cart.currency.symbol }}</span>
                          <input
                            type="number"
                            name="{{ filter.max_value.param_name }}"
                            class="vs-filter-price-field"
                            placeholder="{{ filter.range_max | divided_by: 100.0 | ceil }}"
                            min="0"
                            max="{{ filter.range_max | divided_by: 100.0 | ceil }}"
                            {% if filter.max_value.value %}value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %}
                            aria-label="Maximum price"
                          >
                        </div>
                        <button type="submit" class="vs-filter-price-btn" aria-label="Apply price filter">→</button>
                      </div>
                    </form>
                  </div>
              {% endcase %}
            {% endfor %}
          {% elsif collection.all_tags.size > 0 %}
            {% # Dynamic Product Tags if store uses tags %}
            <div class="vs-filter-group">
              <h4 class="vs-filter-group__title">Tags</h4>
              <ul class="vs-filter-list">
                {% for tag in collection.all_tags %}
                  <li class="vs-filter-item">
                    {% if current_tags contains tag %}
                      <a href="{{ routes.collections_url }}/{{ collection.handle }}" class="vs-filter-link is-active">
                        <span class="vs-filter-checkbox"></span>
                        <span class="vs-filter-name">{{ tag | escape }}</span>
                      </a>
                    {% else %}
                      <a href="{{ routes.collections_url }}/{{ collection.handle }}/{{ tag | handle }}" class="vs-filter-link">
                        <span class="vs-filter-checkbox"></span>
                        <span class="vs-filter-name">{{ tag | escape }}</span>
                      </a>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        </aside>

        {% # Main Catalog Content %}
        <div class="vs-catalog-content">
          <div class="vs-collection-toolbar">
            <div class="vs-toolbar-left">
              <button type="button" class="vs-mobile-filter-btn" data-toggle-filters>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
                </svg>
                <span>Filter Products</span>
              </button>
              <p class="vs-collection-count">
                Showing
                <strong>
                  {%- if collection.products_count > 0 -%}
                    {{ collection.products_count }}
                  {%- else -%}
                    6
                  {%- endif -%}
                </strong>
                products
              </p>
            </div>

            <div class="vs-collection-sort">
              <label for="vs-sort-by" class="vs-sort-label">Sort by:</label>
              <select id="vs-sort-by" class="vs-sort-select" data-collection-sort>
                <option value="featured">Featured</option>
                <option value="best-selling" selected>Best Selling</option>
                <option value="price-ascending">Price: Low to High</option>
                <option value="price-descending">Price: High to Low</option>
                <option value="created-descending">Newest Arrivals</option>
              </select>
            </div>
          </div>

          {% if collection.products.size > 0 %}
            <div
              class="vs-product-grid"
              style="--vs-grid-columns: {{ section.settings.columns_desktop }}"
              role="list"
            >
              {% for product in collection.products %}
                {% assign current_variant = product.selected_or_first_available_variant %}
                
                <article class="vs-bs-card" role="listitem" data-product-handle="{{ product.handle }}">
                  <div class="vs-bs-card__media-wrap">
                    {% # Badges %}
                    <div class="vs-bs-card__badges">
                      {% if product.compare_at_price > product.price %}
                        {% assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
                        <span class="vs-bs-badge vs-bs-badge--sale">Save {{ savings }}%</span>
                      {% elsif forloop.index <= 2 or product.tags contains 'Bestseller' or product.tags contains 'bestseller' %}
                        <span class="vs-bs-badge vs-bs-badge--bestseller">Bestseller</span>
                      {% endif %}
                    </div>

                    {% # Floating Action: Wishlist %}
                    <button
                      type="button"
                      class="vs-card-wishlist-btn"
                      data-wishlist-btn
                      data-product-id="{{ product.id }}"
                      data-product-handle="{{ product.handle }}"
                      data-product-title="{{ product.title | escape }}"
                      data-product-vendor="{{ product.vendor | escape }}"
                      data-product-price="{{ current_variant.price | money }}"
                      data-variant-id="{{ current_variant.id }}"
                      data-product-img="{{ product.featured_media | image_url: width: 300, height: 300 }}"
                      aria-label="Add {{ product.title | escape }} to Wishlist"
                    >
                      <svg class="vs-wishlist-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
                      </svg>
                    </button>

                    {% # Product Image Link %}
                    <a href="{{ product.url }}" class="vs-bs-card__media-link" aria-label="{{ product.title | escape }}">
                      {% if product.featured_media != blank %}
                        <img
                          src="{{ product.featured_media | image_url: width: 600, height: 600, crop: 'center' }}"
                          alt="{{ product.featured_media.alt | default: product.title | escape }}"
                          class="vs-bs-card__img vs-bs-card__img--primary"
                          width="300"
                          height="300"
                          loading="lazy"
                        >
                        {% if product.media.size > 1 %}
                          <img
                            src="{{ product.media[1] | image_url: width: 600, height: 600, crop: 'center' }}"
                            alt="{{ product.media[1].alt | default: product.title | escape }}"
                            class="vs-bs-card__img vs-bs-card__img--secondary"
                            width="300"
                            height="300"
                            loading="lazy"
                          >
                        {% endif %}
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'vs-bs-card__placeholder' }}
                      {% endif %}
                    </a>

                    {% # Quick View Button %}
                    <div class="vs-bs-card__quick-view-overlay">
                      <button
                        type="button"
                        class="vs-bs-quickview-btn"
                        data-quickview-btn
                        data-product-url="{{ product.url }}"
                        data-product-handle="{{ product.handle }}"
                        aria-label="Quick view {{ product.title | escape }}"
                      >
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                          <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                        <span>Quick View</span>
                      </button>
                    </div>
                  </div>

                  {% # Product Meta %}
                  <div class="vs-bs-card__content">
                    {% if product.vendor != blank %}
                      <div class="vs-bs-card__vendor">{{ product.vendor }}</div>
                    {% endif %}

                    <h3 class="vs-bs-card__title">
                      <a href="{{ product.url }}">{{ product.title }}</a>
                    </h3>

                    <div class="vs-bs-card__price-row">
                      <span class="vs-bs-card__price">{{ current_variant.price | money }}</span>
                      {% if current_variant.compare_at_price > current_variant.price %}
                        <s class="vs-bs-card__compare-price">{{ current_variant.compare_at_price | money }}</s>
                      {% endif %}
                    </div>

                    <div class="vs-bs-card__add-row">
                      {% form 'product', product, class: 'vs-bs-add-form' %}
                        <input type="hidden" name="id" value="{{ current_variant.id }}">
                        <input type="hidden" name="quantity" value="1">
                        <button
                          type="submit"
                          name="add"
                          class="vs-bs-add-btn"
                          {% unless current_variant.available %}disabled{% endunless %}
                          aria-label="Add {{ product.title | escape }} to Cart"
                        >
                          <span class="vs-bs-add-btn__text">
                            {% if current_variant.available %}
                              Add To Cart
                            {% else %}
                              Sold Out
                            {% endif %}
                          </span>
                          <svg class="vs-bs-add-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 8h16l-1.2 12H5.2L4 8Z"></path>
                            <path d="M8 9V6a4 4 0 0 1 8 0v3"></path>
                          </svg>
                        </button>
                      {% endform %}
                    </div>
                  </div>
                </article>
              {% endfor %}
            </div>

        {% if paginate.pages > 1 %}
          <div class="vs-pagination">
            {{ paginate | default_pagination }}
          </div>
        {% endif %}
      {% else %}
        {% # Helpful Empty State with Placeholder Products for Instant Previews %}
        <div class="vs-collection-empty">
          {% if section.settings.show_sample_preview %}
            <div class="vs-sample-preview" style="margin-top: 0;">
              <div class="vs-product-grid" style="--vs-grid-columns: {{ section.settings.columns_desktop }}">
                {% if collection.handle == 'all' %}
                  {% assign catalog_products = "Special Mathura Peda,Kesar Malai Peda,Royal Kaju Katli,Motichoor Laddoo,Royal Dry Fruit Mix,Festive Mithai Box" | split: "," %}
                  {% assign catalog_imgs = "product-mathura-peda.jpg,product-kesar-peda.jpg,product-dharwad-peda.jpg,collection-laddoo.jpg,collection-dry-fruits.jpg,product-shahi-peda.jpg" | split: "," %}
                  {% assign catalog_prices = "₹360.00,₹420.00,₹480.00,₹320.00,₹590.00,₹750.00" | split: "," %}
                  {% assign catalog_compares = "₹420.00,₹480.00,₹540.00,₹380.00,₹680.00,₹850.00" | split: "," %}
                  {% assign catalog_badges = "Pure Desi Ghee,Best Seller,Silver Varq,Traditional,Premium Dry Fruits,Festive Special" | split: "," %}

                  {% for prod_name in catalog_products %}
                    {% assign idx = forloop.index0 %}
                    <article class="vs-bs-card" role="listitem">
                      <div class="vs-bs-card__media-wrap">
                        <div class="vs-bs-card__badges">
                          <span class="vs-bs-badge vs-bs-badge--bestseller">{{ catalog_badges[idx] }}</span>
                        </div>

                        <button
                          type="button"
                          class="vs-card-wishlist-btn"
                          data-wishlist-btn
                          aria-label="Add {{ prod_name }} to Wishlist"
                        >
                          <svg class="vs-wishlist-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
                          </svg>
                        </button>

                        <a href="/products/pure-desi-ghee-khoya-peda" class="vs-bs-card__media-link" aria-label="{{ prod_name }}">
                          <img
                            class="vs-bs-card__img vs-bs-card__img--primary"
                            src="{{ catalog_imgs[idx] | asset_url }}"
                            alt="{{ prod_name }}"
                            width="300"
                            height="300"
                            loading="lazy"
                          >
                        </a>
                      </div>

                      <div class="vs-bs-card__content">
                        <div class="vs-bs-card__vendor">VEDANT SWEETS</div>
                        <h3 class="vs-bs-card__title">
                          <a href="/products/pure-desi-ghee-khoya-peda">{{ prod_name }}</a>
                        </h3>

                        <div class="vs-bs-card__price-row">
                          <span class="vs-bs-card__price">{{ catalog_prices[idx] }}</span>
                          <s class="vs-bs-card__compare-price">{{ catalog_compares[idx] }}</s>
                        </div>

                        <div class="vs-bs-card__add-row">
                          <button type="button" class="vs-bs-add-btn">
                            <span class="vs-bs-add-btn__text">Add To Cart</span>
                            <svg class="vs-bs-add-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M4 8h16l-1.2 12H5.2L4 8Z"></path>
                              <path d="M8 9V6a4 4 0 0 1 8 0v3"></path>
                            </svg>
                          </button>
                        </div>
                      </div>
                    </article>
                  {% endfor %}
                {% else %}
                  {% assign peda_products = "Special Mathura Peda,Kesar Malai Peda,Dharwad Brown Peda,Shahi Mawa Peda" | split: "," %}
                  {% assign peda_imgs = "product-mathura-peda.jpg,product-kesar-peda.jpg,product-dharwad-peda.jpg,product-shahi-peda.jpg" | split: "," %}
                  {% assign peda_prices = "₹360.00,₹420.00,₹390.00,₹450.00" | split: "," %}
                  {% assign peda_compares = "₹420.00,₹480.00,₹450.00,₹520.00" | split: "," %}
                  {% assign peda_badges = "Pure Desi Ghee,Best Seller,Traditional,Rich Kesar" | split: "," %}
                  
                  {% for prod_name in peda_products %}
                    {% assign idx = forloop.index0 %}
                    <article class="vs-bs-card" role="listitem">
                      <div class="vs-bs-card__media-wrap">
                        <div class="vs-bs-card__badges">
                          <span class="vs-bs-badge vs-bs-badge--bestseller">{{ peda_badges[idx] }}</span>
                        </div>

                        <button
                          type="button"
                          class="vs-card-wishlist-btn"
                          data-wishlist-btn
                          aria-label="Add {{ prod_name }} to Wishlist"
                        >
                          <svg class="vs-wishlist-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
                          </svg>
                        </button>

                        <a href="/products/pure-desi-ghee-khoya-peda" class="vs-bs-card__media-link" aria-label="{{ prod_name }}">
                          <img
                            class="vs-bs-card__img vs-bs-card__img--primary"
                            src="{{ peda_imgs[idx] | asset_url }}"
                            alt="{{ prod_name }}"
                            width="300"
                            height="300"
                            loading="lazy"
                          >
                        </a>
                      </div>

                      <div class="vs-bs-card__content">
                        <div class="vs-bs-card__vendor">VEDANT SWEETS</div>
                        <h3 class="vs-bs-card__title">
                          <a href="/products/pure-desi-ghee-khoya-peda">{{ prod_name }}</a>
                        </h3>

                        <div class="vs-bs-card__price-row">
                          <span class="vs-bs-card__price">{{ peda_prices[idx] }}</span>
                          <s class="vs-bs-card__compare-price">{{ peda_compares[idx] }}</s>
                        </div>

                        <div class="vs-bs-card__add-row">
                          <button type="button" class="vs-bs-add-btn">
                            <span class="vs-bs-add-btn__text">Add To Cart</span>
                            <svg class="vs-bs-add-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M4 8h16l-1.2 12H5.2L4 8Z"></path>
                              <path d="M8 9V6a4 4 0 0 1 8 0v3"></path>
                            </svg>
                          </button>
                        </div>
                      </div>
                    </article>
                  {% endfor %}
                {% endif %}
              </div>
            </div>
          {% else %}
            <div class="vs-empty-message">
              <div class="vs-empty-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                  <path d="M3 6h18"/>
                  <path d="M16 10a4 4 0 0 1-8 0"/>
                </svg>
              </div>
              <h2 class="vs-empty-title">Products Coming Soon to {{ collection.title | escape }}</h2>
              <p class="vs-empty-desc">
                We are preparing fresh artisanal batches for this collection. Add products in your Shopify Admin and assign them to <strong>{{ collection.title | escape }}</strong>.
              </p>
              <a class="vs-empty-btn" href="{{ routes.collections_url }}">
                <span>Explore All Collections</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          {% endif %}
        </div>
      {% endif %}
      </div>
    </div>
  </div>
  {% endpaginate %}
</section>

{% schema %}
{
  "name": "Collection Page",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Products per row (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
