<vedanta-hero-slider
  class="vs-hero-slider full-width"
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.autoplay_interval | times: 1000 }}"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.accessible_label | escape }}"
  style="--vs-hero-height: {{ section.settings.desktop_height }}px"
>
  <div class="vs-hero-slider__slides" aria-live="polite">
    {% for block in section.blocks %}
      <article
        class="vs-hero-slide{% if forloop.first %} is-active{% endif %}"
        data-hero-slide
        role="group"
        aria-roledescription="slide"
        aria-label="Slide {{ forloop.index }} of {{ section.blocks.size }}"
        {% unless forloop.first %}
          aria-hidden="true"
          hidden
        {% endunless %}
        {{ block.shopify_attributes }}
      >
        {% assign slide_bg = '' %}
        {% if block.settings.image != blank %}
          {% assign slide_bg = block.settings.image | image_url: width: 3840 %}
        {% elsif block.settings.preset_image != blank %}
          {% assign slide_bg = block.settings.preset_image | asset_url %}
        {% endif %}

        <div
          class="vs-hero-slide__background"
          style="--vs-hero-background: url('{{ slide_bg }}')"
          role="img"
          aria-label="{{ block.settings.heading | default: 'Hero Slide' | escape }}"
        ></div>

        <div class="vs-hero-slide__content">
          {% if block.settings.eyebrow != blank %}
            <p class="vs-hero-slide__eyebrow">{{ block.settings.eyebrow | escape }}</p>
          {% endif %}
          {% if block.settings.heading != blank %}
            <h2 class="vs-hero-slide__heading">{{ block.settings.heading | escape | newline_to_br }}</h2>
          {% endif %}
          {% if block.settings.copy != blank %}
            <p class="vs-hero-slide__copy">{{ block.settings.copy | escape }}</p>
          {% endif %}
          {% if block.settings.button_label != blank and block.settings.button_link != blank %}
            <a class="vs-hero-slide__button" href="{{ block.settings.button_link | escape }}">
              {{ block.settings.button_label | escape }}
              <span aria-hidden="true">→</span>
            </a>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>

  {% if section.blocks.size > 1 %}
    <div class="vs-hero-slider__controls">
      <button
        class="vs-hero-slider__arrow"
        type="button"
        data-hero-action="previous"
        aria-label="Previous slide"
      >
        <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
          <path d="m15 18-6-6 6-6"></path>
        </svg>
      </button>

      <div class="vs-hero-slider__pagination" role="group" aria-label="Choose a slide">
        {% for block in section.blocks %}
          <button
            class="vs-hero-slider__dot{% if forloop.first %} is-active{% endif %}"
            type="button"
            data-hero-index="{{ forloop.index0 }}"
            aria-label="Slide {{ forloop.index }} of {{ section.blocks.size }}"
            {% if forloop.first %}aria-current="true"{% endif %}
          ></button>
        {% endfor %}
      </div>

      {% if section.settings.autoplay %}
        <button
          class="vs-hero-slider__toggle"
          type="button"
          data-hero-action="toggle"
          data-play-label="Start automatic slide rotation"
          data-pause-label="Pause automatic slide rotation"
          aria-label="Pause automatic slide rotation"
        >
          <svg class="vs-hero-slider__pause-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
            <path d="M9 5v14M15 5v14"></path>
          </svg>
          <svg class="vs-hero-slider__play-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
            <path d="m8 5 12 7-12 7V5Z"></path>
          </svg>
        </button>
      {% endif %}

      <button
        class="vs-hero-slider__arrow"
        type="button"
        data-hero-action="next"
        aria-label="Next slide"
      >
        <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
          <path d="m9 18 6-6-6-6"></path>
        </svg>
      </button>
    </div>
  {% endif %}
</vedanta-hero-slider>

{% schema %}
{
  "name": "Hero Slider",
  "settings": [
    {
      "type": "text",
      "id": "accessible_label",
      "label": "Accessible label",
      "default": "Vedanta Sweets featured collection"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Slide rotation speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 480,
      "max": 750,
      "step": 10,
      "unit": "px",
      "default": 680
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Background Image"
        },
        {
          "type": "text",
          "id": "preset_image",
          "label": "Asset File Name",
          "info": "Filename from assets (e.g. s1.png, s2.png)"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Vedanta Sweets"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "A Tradition of Pure Goodness"
        },
        {
          "type": "textarea",
          "id": "copy",
          "label": "Copy",
          "default": "Bringing you the finest Indian sweets, crafted with traditional recipes, premium ingredients and a lot of love."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Explore our sweets"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slider",
      "blocks": [
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
