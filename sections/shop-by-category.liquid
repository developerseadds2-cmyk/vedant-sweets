<section
  class="vs-category-section full-width"
  id="vs-category-section-{{ section.id }}"
  style="--vs-cat-padding-y: {{ section.settings.padding_y }}px;"
>
  <div class="vs-category-inner">
    <header class="vs-category-header">
      {% if section.settings.eyebrow != blank %}
        <div class="vs-category-eyebrow">
          <span class="vs-ornament-line" aria-hidden="true"></span>
          <span class="vs-eyebrow-text">{{ section.settings.eyebrow | escape }}</span>
          <span class="vs-ornament-line" aria-hidden="true"></span>
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="vs-category-heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <p class="vs-category-subtitle">{{ section.settings.subtitle | escape }}</p>
      {% endif %}

      <div class="vs-category-lotus-divider" aria-hidden="true">
        <span class="vs-lotus-line"></span>
        <svg class="vs-lotus-icon" viewBox="0 0 36 20" fill="none" stroke="currentColor">
          <path d="M18 18C18 18 12 11 12 6.5C12 3.5 14.5 1 18 1C21.5 1 24 3.5 24 6.5C24 11 18 18 18 18Z" stroke-width="1.3"/>
          <path d="M18 18C18 18 8 13.5 6 9C4 4.5 6.5 2 9.5 2.5C12.5 3 15.5 8 18 18Z" stroke-width="1.2"/>
          <path d="M18 18C18 18 28 13.5 30 9C32 4.5 29.5 2 26.5 2.5C23.5 3 20.5 8 18 18Z" stroke-width="1.2"/>
          <path d="M18 18C18 18 4 16.5 1.5 12C-1 7.5 1.5 5 4.5 6C7.5 7 13 13 18 18Z" stroke-width="1.1"/>
          <path d="M18 18C18 18 32 16.5 34.5 12C37 7.5 34.5 5 31.5 6C28.5 7 23 13 18 18Z" stroke-width="1.1"/>
        </svg>
        <span class="vs-lotus-line"></span>
      </div>
    </header>

    <div
      class="vs-category-carousel-wrapper"
      data-category-carousel
      data-autoplay="{{ section.settings.autoplay }}"
      data-interval="{{ section.settings.autoplay_interval | times: 1000 }}"
      data-loop="{{ section.settings.infinite_loop }}"
    >
      <button
        type="button"
        class="vs-carousel-arrow vs-carousel-arrow--prev"
        data-carousel-prev
        aria-label="Previous categories"
      >
        <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
          <path d="m15 18-6-6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="vs-category-track" data-carousel-track role="list">
        {% assign source_mode = section.settings.collection_source | default: 'all' %}
        {% assign rendered_cards_count = 0 %}

        {% if source_mode == 'all' %}
          {% for coll in collections limit: section.settings.collection_limit %}
            {% if coll.handle == 'frontpage' and collections.size > 1 %}
              {% continue %}
            {% endif %}
            {% assign rendered_cards_count = rendered_cards_count | plus: 1 %}
            {% assign card_title = coll.title %}
            {% assign card_url = coll.url %}
            {% assign card_image = coll.featured_image | default: coll.image %}

            <article class="vs-category-circle-card" role="listitem">
              <a class="vs-category-circle-card__link" href="{{ card_url }}">
                <div class="vs-category-circle-card__media-wrap">
                  <div class="vs-category-circle-card__media">
                    {% if card_image != blank %}
                      <img
                        class="vs-category-circle-card__image"
                        src="{{ card_image | image_url: width: 480, height: 480, crop: 'center' }}"
                        alt="{{ card_title | escape }}"
                        width="180"
                        height="180"
                        loading="lazy"
                      >
                    {% else %}
                      {{ 'collection-1' | placeholder_svg_tag: 'vs-category-circle-card__placeholder' }}
                    {% endif %}
                  </div>
                </div>

                <h3 class="vs-category-circle-card__title">{{ card_title | escape }}</h3>
                <span class="vs-category-circle-card__circle-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </span>
              </a>
            </article>
          {% endfor %}

        {% elsif source_mode == 'selected' %}
          {% assign collection_list = section.settings.collection_list %}
          {% if collection_list != blank and collection_list != empty %}
            {% for coll in collection_list limit: section.settings.collection_limit %}
              {% assign rendered_cards_count = rendered_cards_count | plus: 1 %}
              {% assign card_title = coll.title %}
              {% assign card_url = coll.url %}
              {% assign card_image = coll.featured_image | default: coll.image %}

              <article class="vs-category-circle-card" role="listitem">
                <a class="vs-category-circle-card__link" href="{{ card_url }}">
                  <div class="vs-category-circle-card__media-wrap">
                    <div class="vs-category-circle-card__media">
                      {% if card_image != blank %}
                        <img
                          class="vs-category-circle-card__image"
                          src="{{ card_image | image_url: width: 480, height: 480, crop: 'center' }}"
                          alt="{{ card_title | escape }}"
                          width="180"
                          height="180"
                          loading="lazy"
                        >
                      {% else %}
                        {{ 'collection-1' | placeholder_svg_tag: 'vs-category-circle-card__placeholder' }}
                      {% endif %}
                    </div>
                  </div>

                  <h3 class="vs-category-circle-card__title">{{ card_title | escape }}</h3>
                  <span class="vs-category-circle-card__circle-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </span>
                </a>
              </article>
            {% endfor %}
          {% endif %}
        {% endif %}

        {% if rendered_cards_count == 0 %}
          {% for block in section.blocks %}
            {% assign collection = block.settings.collection %}
            {% assign card_title = block.settings.title | default: collection.title | default: block.settings.default_title %}
            {% assign card_url = collection.url | default: block.settings.custom_url | default: '/collections/all' %}
            {% assign card_image = block.settings.image | default: collection.featured_image | default: collection.image %}
            {% assign preset_image_name = block.settings.preset_image %}

            <article class="vs-category-circle-card" role="listitem" {{ block.shopify_attributes }}>
              <a class="vs-category-circle-card__link" href="{{ card_url }}">
                <div class="vs-category-circle-card__media-wrap">
                  <div class="vs-category-circle-card__media">
                    {% if card_image != blank %}
                      <img
                        class="vs-category-circle-card__image"
                        src="{{ card_image | image_url: width: 480, height: 480, crop: 'center' }}"
                        alt="{{ card_title | escape }}"
                        width="180"
                        height="180"
                        loading="lazy"
                      >
                    {% elsif preset_image_name != blank %}
                      <img
                        class="vs-category-circle-card__image"
                        src="{{ preset_image_name | asset_url }}"
                        alt="{{ card_title | escape }}"
                        width="180"
                        height="180"
                        loading="lazy"
                      >
                    {% else %}
                      {{ 'collection-1' | placeholder_svg_tag: 'vs-category-circle-card__placeholder' }}
                    {% endif %}
                  </div>
                </div>

                <h3 class="vs-category-circle-card__title">{{ card_title | escape }}</h3>
                <span class="vs-category-circle-card__circle-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </span>
              </a>
            </article>
          {% endfor %}
        {% endif %}
      </div>

      <button
        type="button"
        class="vs-carousel-arrow vs-carousel-arrow--next"
        data-carousel-next
        aria-label="Next categories"
      >
        <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
          <path d="m9 18 6-6-6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    {% if section.settings.button_label != blank %}
      <div class="vs-category-footer">
        <a class="vs-category-view-all" href="{{ section.settings.button_url | default: routes.collections_url }}">
          {{ section.settings.button_label | escape }}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Shop by Category",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "SHOP BY CATEGORY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore Our Wide Range of Traditional & Premium Sweets"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "From timeless classics to special treats, find the perfect sweetness for every occasion and celebration."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "View All Button Label",
      "default": "View All Collections"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "View All Button URL"
    },
    {
      "type": "header",
      "content": "Backend Collections Source"
    },
    {
      "type": "select",
      "id": "collection_source",
      "label": "Category Source",
      "options": [
        {
          "value": "all",
          "label": "Automatic: Show all backend collections"
        },
        {
          "value": "selected",
          "label": "Selected: Choose specific collections below"
        },
        {
          "value": "blocks",
          "label": "Manual: Individual card blocks"
        }
      ],
      "default": "all",
      "info": "Automatic mode pulls live collections directly from your Shopify Admin dashboard."
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "Select Collections",
      "info": "Used when 'Selected' mode is active above."
    },
    {
      "type": "range",
      "id": "collection_limit",
      "label": "Maximum Categories to Display",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "header",
      "content": "Carousel & Autoplay"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-play Slider",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Auto-play Interval (seconds)",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "infinite_loop",
      "label": "Enable Infinite Loop",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection (Backend Connection)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title Override (optional)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image (optional)"
        },
        {
          "type": "text",
          "id": "preset_image",
          "label": "Default Asset Image (internal)",
          "default": "collection-laddoo.jpg"
        },
        {
          "type": "text",
          "id": "default_title",
          "label": "Default Title",
          "default": "Ladoos"
        },
        {
          "type": "url",
          "id": "custom_url",
          "label": "Custom URL (if no collection selected)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "default_title": "Ladoos",
            "preset_image": "collection-laddoo.jpg"
          }
        },
        {
          "type": "category",
          "settings": {
            "default_title": "Kaju Katli",
            "preset_image": "collection-kaju.jpg"
          }
        },
        {
          "type": "category",
          "settings": {
            "default_title": "Barfi",
            "preset_image": "collection-mithai.jpg"
          }
        },
        {
          "type": "category",
          "settings": {
            "default_title": "Dry Fruits",
            "preset_image": "collection-dry-fruits.jpg"
          }
        },
        {
          "type": "category",
          "settings": {
            "default_title": "Peda & Sandesh",
            "preset_image": "collection-peda.jpg"
          }
        },
        {
          "type": "category",
          "settings": {
            "default_title": "Gift Boxes",
            "preset_image": "collection-gift-packs.jpg"
          }
        }
      ]
    }
  ]
}
{% endschema %}
