{% doc %}
  Renders a refined gold line-art SVG icon for collection category cards.

  @param {string} [icon] - Name of the category icon ('mithai', 'laddoo', 'peda', 'kaju', 'dry-fruits', 'gift-packs')

  @example
  {% render 'category-icon', icon: 'mithai' %}
{% enddoc %}

{% case icon %}
  {% when 'laddoo' %}
    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="10" cy="18" r="5" />
      <circle cx="18" cy="18" r="5" />
      <circle cx="14" cy="10" r="5" />
      <path d="M14 9a1.2 1.2 0 1 0 0-2.4 1.2 1.2 0 0 0 0 2.4Z" fill="currentColor" stroke="none"/>
    </svg>

  {% when 'peda' %}
    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <ellipse cx="14" cy="14" rx="9" ry="8" />
      <circle cx="14" cy="14" r="3.5" stroke-dasharray="2 2"/>
      <circle cx="14" cy="14" r="1.5" fill="currentColor" stroke="none"/>
      <path d="M14 5v2M14 21v2M5 14h2M21 14h2" />
    </svg>

  {% when 'kaju' %}
    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 4 23 14 14 24 5 14 Z" />
      <path d="M14 9 19 14 14 19 9 14 Z" stroke-width="1.2" stroke-dasharray="1.5 1.5"/>
      <circle cx="14" cy="14" r="1.5" fill="currentColor" stroke="none"/>
    </svg>

  {% when 'dry-fruits' %}
    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 4c5 0 9 4.5 9 10s-4 10-9 10-9-4.5-9-10S9 4 14 4Z" />
      <path d="M14 8c-3 3-3 9 0 12" />
      <path d="M14 12c1.5 1 2.5 3 2 5" />
    </svg>

  {% when 'gift-packs' %}
    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="5" y="11" width="18" height="13" rx="2" />
      <path d="M3 7h22v4H3z" />
      <path d="M14 7v17M14 7c-2-3-6-3-6 0s4 3 6 0zM14 7c2-3 6-3 6 0s-4 3-6 0z" />
    </svg>

  {% else %}
    <!-- mithai / default festive floral lotus icon -->
    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 5c2 4 6 7 9 7-3 2-6 5-7 11-1-6-4-9-7-11 3 0 7-3 5-7Z" />
      <circle cx="14" cy="14" r="2" fill="currentColor" stroke="none" />
      <circle cx="8" cy="14" r="1.2" fill="currentColor" stroke="none" />
      <circle cx="20" cy="14" r="1.2" fill="currentColor" stroke="none" />
    </svg>
{% endcase %}

