<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'main.css' | asset_url | stylesheet_tag }}
    {% render 'font-face-styles' %}
    <script src="{{ 'index.js' | asset_url }}" defer></script>

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {% # Auto-default localization to India (IN) if not currently set %}
    {% unless localization.country.iso_code == 'IN' %}
      <script>
        (function() {
          try {
            var attempted = sessionStorage.getItem('vs_auto_loc_in');
            if (!attempted) {
              sessionStorage.setItem('vs_auto_loc_in', '1');
              var formData = new FormData();
              formData.append('_method', 'put');
              formData.append('country_code', 'IN');
              fetch('/localization', {
                method: 'POST',
                body: formData,
                credentials: 'same-origin'
              }).then(function(res) {
                if (res.ok) {
                  window.location.reload();
                }
              }).catch(function(err) {
                console.warn('Auto localization error:', err);
              });
            }
          } catch(e) {
            console.warn(e);
          }
        })();
      </script>
    {% endunless %}

    {{ content_for_header }}
  </head>

  <body
    style="
      --vs-font-heading: {{ settings.type_heading_font.family | json }}, {{ settings.type_heading_font.fallback_families }};
      --vs-font-body: {{ settings.type_primary_font.family | json }}, {{ settings.type_primary_font.fallback_families }};
    "
  >
    <div id="vs-preloader" class="vs-preloader" aria-hidden="true">
      <div class="vs-preloader__inner">
        <div class="vs-preloader__ring"></div>
        <img
          class="vs-preloader__logo"
          src="{{ 'logo.png' | asset_url }}"
          alt="{{ shop.name | escape }}"
          width="554"
          height="450"
        >
      </div>
    </div>
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}

    {% # Global Quick View Modal Dialog %}
    <div id="vs-quickview-modal" class="vs-quickview-modal" aria-hidden="true" role="dialog" aria-modal="true">
      <div class="vs-quickview-backdrop" data-close-quickview></div>
      <div class="vs-quickview-dialog">
        <button type="button" class="vs-quickview-close" data-close-quickview aria-label="Close modal">✕</button>
        <div class="vs-quickview-body" id="vs-quickview-body">
          <div class="vs-quickview-loading">
            <svg class="vs-quickview-spinner" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" opacity="0.25"></circle>
              <path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
